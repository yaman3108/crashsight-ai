# CrashSight AI — Environment Variables
# Copy this file to .env and fill in your values

# Google Earth Engine
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=

# NewsAPI
NEWSAPI_KEY=

# GDELT (no key needed — free API)

# Weights & Biases
WANDB_API_KEY=
WANDB_PROJECT=crashsight-ai

# Database (optional — for PostgreSQL + PostGIS)
DATABASE_URL=postgresql://user:pass@localhost:5432/crashsight
